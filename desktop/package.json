{
  "name": "jarvis-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Personal Jarvis desktop companion",
  "author": "Jarvis project",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests.cjs account-test.cjs",
    "pack": "electron-builder --win dir"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.oneaigen.jarvis",
    "productName": "Jarvis",
    "files": [
      "main.cjs",
      "preload.cjs",
      "account.cjs",
      "logic.cjs",
      "index.html",
      "style.css",
      "renderer.js",
      "speech.cjs",
      "recorder.js",
      "assets/*",
      "voice-utils.js"
    ],
    "win": {
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "transcribe.py",
        "to": "transcribe.py"
      },
      {
        "from": "speech-runtime.json",
        "to": "speech-runtime.json"
      }
    ]
  }
}
